# Source format: https://invisible-island.net/ncurses/man/terminfo.5.html
# Deliberately standalone: no inherited Kitty, mouse, graphics or extended keyboard claims.
# Embedded compiled entry is exposed through a private per-session TERMINFO directory.
ptyra|Ptyra conservative terminal,
	am, xenl,
	cols#80, lines#24, colors#8, pairs#64,
	clear=\E[H\E[2J,
	cup=\E[%i%p1%d;%p2%dH,
	el=\E[K, ed=\E[J,
	cr=\r, ind=\n,
	cuu1=\E[A, cud1=\E[B, cub1=\E[D, cuf1=\E[C,
	sgr0=\E[0m, rev=\E[7m,
	setaf=\E[3%p1%dm, setab=\E[4%p1%dm,
	smcup=\E[?1049h, rmcup=\E[?1049l,
